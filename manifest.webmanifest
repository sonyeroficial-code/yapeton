{
  "name": "Yape",
  "short_name": "Yape",
  "description": "App web Yape compatible con Android, iPhone y modo sin internet.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "fullscreen",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait",
  "background_color": "#87009A",
  "theme_color": "#87009A",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./assets/icono_app_yape.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "categories": [
    "finance",
    "utilities"
  ],
  "lang": "es-PE"
}